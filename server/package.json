{
  "name": "turnup-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for Turnup (Express + MySQL)",
  "scripts": {
    "start": "node src/index.js",
    "predev": "npm update --no-fund --loglevel=error && npm audit fix --no-fund --loglevel=error || true",
    "dev": "node --watch src/index.js",
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --fresh",
    "load-test": "node scripts/load-test.js",
    "demo:export": "node scripts/export-demo.js",
    "simulate-door": "node scripts/simulate-door.js",
    "reset-door": "node scripts/reset-door.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
