# Copy this file to .env and fill it in.

PORT=5080
CLIENT_ORIGIN=http://localhost:5175

# MySQL. Either a single DATABASE_URL (mysql://user:pass@host:3306/turnup) or the separate parts.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=turnup
DB_PASSWORD=
DB_NAME=turnup
# Hosted databases usually need an encrypted connection: set to true for them.
DB_SSL=false

# Use a long random string in production (for example `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Password given to every sample account created by `npm run db:setup`
SEED_PASSWORD=turnup123

# Paystack. Leave empty to use built-in test payments (no real money, no account needed).
PAYSTACK_SECRET_KEY=
PUBLIC_URL=http://localhost:5175
